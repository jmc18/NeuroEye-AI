APP_NAME=NeuroEyeAI

DB_HOST=localhost
DB_PORT=5432
DB_NAME=neuroeye
DB_USER=postgres
DB_PASSWORD=postgres

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256

# Comma-separated origins for CORS (dev)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_API_URL=http://localhost:8000

# development | production | staging
APP_ENV=development

# Auto migrate + seed on API startup (like EF Core Migrate + Seed)
RUN_MIGRATIONS_ON_STARTUP=true
RUN_SEEDERS_ON_STARTUP=true
# Set true to seed only when APP_ENV=development (.NET IsDevelopment() style)
SEEDERS_DEVELOPMENT_ONLY=false
# Lifespan hook (F5 debug, run.py). Set false if entrypoint runs startup first.
RUN_DB_STARTUP_IN_LIFESPAN=true

# Platform super admin (used by seeders)
SEED_PLATFORM_EMAIL=mtzcornejo66@gmail.com
SEED_PLATFORM_PASSWORD=1234567890!
SEED_PLATFORM_FIRST_NAME=Javier
SEED_PLATFORM_LAST_NAME=Martínez
SEED_PLATFORM_SECOND_LAST_NAME=Cornejo

# Demo clinician (used by clinical seeders)
SEED_CLINICIAN_EMAIL=clinician@neuroeye.ai
SEED_CLINICIAN_PASSWORD=Clinician123!
SEED_CLINICIAN_FIRST_NAME=Aris
SEED_CLINICIAN_LAST_NAME=Thorne
