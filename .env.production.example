# Copy to repo root: cp .env.production.example .env.production

APP_NAME=NeuroEyeAI

# Database (used by API + postgres service)
DB_NAME=neuroeye
DB_USER=postgres
DB_PASSWORD=change_me_strong_password

# Redis — host/port overridden in compose for containers
REDIS_HOST=localhost
REDIS_PORT=6379

# Security — CHANGE before deploy
JWT_SECRET_KEY=change_me_use_openssl_rand_hex_32
JWT_ALGORITHM=HS256

# Public URL (Scalar docs, CORS). Use your domain with https in production.
PUBLIC_API_URL=https://your-domain.com
CORS_ORIGINS=https://your-domain.com

# API container
APP_ENV=production
UVICORN_WORKERS=2
RUN_MIGRATIONS_ON_STARTUP=true
RUN_SEEDERS_ON_STARTUP=true
SEEDERS_DEVELOPMENT_ONLY=false
RUN_DB_STARTUP_BEFORE_UVICORN=true
RUN_DB_STARTUP_IN_LIFESPAN=false

# Host port for nginx (web service)
HTTP_PORT=80

# Platform super admin (seeded automatically when RUN_SEEDERS_ON_STARTUP=true)
SEED_PLATFORM_EMAIL=admin@example.com
SEED_PLATFORM_PASSWORD=change_me
SEED_PLATFORM_FIRST_NAME=Admin
SEED_PLATFORM_LAST_NAME=User
SEED_PLATFORM_SECOND_LAST_NAME=
